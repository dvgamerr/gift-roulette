---
import WheelSection from './WheelSection.astro';
import FriendsList from './FriendsList.astro';
import HistoryList from './HistoryList.astro';
---
<div class="flex flex-col md:flex-row w-full">
  <div class="p-4 md:w-2/3">
    <WheelSection />
  </div>

  <div class="space-y-6 p-4 md:w-1/3">
    <FriendsList />
    <HistoryList />
  </div>
</div>

<script>
  import {
    createExchangeState,
    getSpinTargetAngle,
    parseParticipants,
    selectParticipant
  } from '../lib/giftExchange';

  const DEFAULT_PARTICIPANTS = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
  const WHEEL_MAX_SIZE = 480;
  const POINTER_LENGTH = 20;
  const WHEEL_EDGE_GAP = 4;
  const NAME_DISPLAY_VISIBLE_CLASS = 'opacity-100';
  const NAME_DISPLAY_HIDDEN_CLASS = 'opacity-0';

  let confetti:
    | ((options: {
        origin: { y: number };
        particleCount: number;
        spread: number;
      }) => void)
    | undefined;

  void import('canvas-confetti')
    .then((module) => {
      confetti = module.default;
    })
    .catch(() => undefined);

  let participants = [...DEFAULT_PARTICIPANTS];
  let exchangeState = createExchangeState(DEFAULT_PARTICIPANTS);
  let spinning = false;
  let wheelCanvas: HTMLCanvasElement | null = null;
  let wheelCtx: CanvasRenderingContext2D | null = null;
  let rotationAngle = 0;
  let animationId: number | null = null;
  let winnerDisplayTimeoutId: number | null = null;
  let resizeObserver: ResizeObserver | null = null;

  const getAvailableFriends = () => exchangeState.availableParticipants;

  const getFriendsTextarea = (): HTMLTextAreaElement | null => {
    const element = document.getElementById('friendsTextarea');
    return element instanceof HTMLTextAreaElement ? element : null;
  };

  const getFriendsList = (): HTMLUListElement | null => {
    const element = document.getElementById('friendsList');
    return element instanceof HTMLUListElement ? element : null;
  };

  const getFriendsCount = (): HTMLSpanElement | null => {
    const element = document.getElementById('friendsCount');
    return element instanceof HTMLSpanElement ? element : null;
  };

  const getFriendsEmptyState = (): HTMLParagraphElement | null => {
    const element = document.getElementById('friendsEmptyState');
    return element instanceof HTMLParagraphElement ? element : null;
  };

  const getGiftHistoryList = (): HTMLUListElement | null => {
    const element = document.getElementById('giftHistory');
    return element instanceof HTMLUListElement ? element : null;
  };

  const getGiftHistoryEmptyState = (): HTMLParagraphElement | null => {
    const element = document.getElementById('historyEmptyState');
    return element instanceof HTMLParagraphElement ? element : null;
  };

  const getNameDisplay = (): HTMLDivElement | null => {
    const element = document.getElementById('nameDisplay');
    return element instanceof HTMLDivElement ? element : null;
  };

  const getSpinButton = (): HTMLButtonElement | null => {
    const element = document.getElementById('spinButton');
    return element instanceof HTMLButtonElement ? element : null;
  };

  const getResetButton = (): HTMLButtonElement | null => {
    const element = document.getElementById('resetButton');
    return element instanceof HTMLButtonElement ? element : null;
  };

  const getStatusMessage = (): HTMLParagraphElement | null => {
    const element = document.getElementById('statusMessage');
    return element instanceof HTMLParagraphElement ? element : null;
  };

  const generatePastelColors = (count: number) => {
    const colors: string[] = [];
    for (let i = 0; i < count; i++) {
      const hue = (i * (360 / count)) % 360;
      colors.push(`hsl(${hue}, 70%, 85%)`);
    }
    return colors;
  };

  let colors: string[] = [];

  const getWheelMessage = () => {
    if (exchangeState.history.length > 0 && getAvailableFriends().length === 0) {
      return 'Draw complete';
    }

    if (participants.length < 2) {
      return 'Add 2+ names';
    }

    return 'Ready to spin';
  };

  const drawEmptyWheelState = (message: string) => {
    if (!wheelCanvas || !wheelCtx) return;

    const centerX = wheelCanvas.width / 2;
    const centerY = wheelCanvas.height / 2;
    const radius = Math.min(centerX, centerY) - 10;

    wheelCtx.clearRect(0, 0, wheelCanvas.width, wheelCanvas.height);
    wheelCtx.beginPath();
    wheelCtx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
    wheelCtx.fillStyle = '#f8fafc';
    wheelCtx.fill();
    wheelCtx.strokeStyle = '#cbd5e1';
    wheelCtx.lineWidth = 2;
    wheelCtx.setLineDash([8, 10]);
    wheelCtx.stroke();
    wheelCtx.setLineDash([]);

    wheelCtx.fillStyle = '#64748b';
    wheelCtx.font = '600 18px Arial';
    wheelCtx.textAlign = 'center';
    wheelCtx.textBaseline = 'middle';
    wheelCtx.fillText(message, centerX, centerY);
  };

  const drawWheel = () => {
    if (!wheelCanvas || !wheelCtx) return;

    const availableFriends = getAvailableFriends();
    const numSegments = availableFriends.length;
    if (numSegments === 0) {
      drawEmptyWheelState(getWheelMessage());
      return;
    }

    if (colors.length !== numSegments) {
      colors = generatePastelColors(numSegments);
    }

    const centerX = wheelCanvas.width / 2;
    const centerY = wheelCanvas.height / 2;
    const radius = Math.min(centerX, centerY) - POINTER_LENGTH - WHEEL_EDGE_GAP;
    const angleSlice = (2 * Math.PI) / numSegments;

    wheelCtx.clearRect(0, 0, wheelCanvas.width, wheelCanvas.height);
    wheelCtx.save();
    wheelCtx.translate(centerX, centerY);
    wheelCtx.rotate(rotationAngle);

    for (let i = 0; i < numSegments; i++) {
      const color = colors[i];
      const friend = availableFriends[i];
      if (color === undefined || friend === undefined) continue;

      const startAngle = i * angleSlice;
      const endAngle = (i + 1) * angleSlice;

      wheelCtx.beginPath();
      wheelCtx.moveTo(0, 0);
      wheelCtx.arc(0, 0, radius, startAngle, endAngle);
      wheelCtx.closePath();
      wheelCtx.fillStyle = color;
      wheelCtx.fill();
      wheelCtx.strokeStyle = '#ffffff';
      wheelCtx.lineWidth = 2;
      wheelCtx.stroke();

      wheelCtx.save();
      wheelCtx.rotate(startAngle + angleSlice / 2);
      wheelCtx.textAlign = 'right';
      wheelCtx.fillStyle = '#333333';
      wheelCtx.font = 'bold 16px Arial';
      wheelCtx.fillText(friend, radius - 20, 5);
      wheelCtx.restore();
    }

    const gradient = wheelCtx.createRadialGradient(0, 0, 0, 0, 0, 20);
    gradient.addColorStop(0, '#ffffff');
    gradient.addColorStop(1, '#f0f0f0');

    wheelCtx.beginPath();
    wheelCtx.arc(0, 0, 20, 0, 2 * Math.PI);
    wheelCtx.fillStyle = gradient;
    wheelCtx.fill();
    wheelCtx.strokeStyle = '#cccccc';
    wheelCtx.lineWidth = 1;
    wheelCtx.stroke();

    wheelCtx.restore();

    wheelCtx.beginPath();
    wheelCtx.moveTo(centerX + radius, centerY);
    wheelCtx.lineTo(centerX + radius + 20, centerY - 10);
    wheelCtx.lineTo(centerX + radius + 20, centerY + 10);
    wheelCtx.closePath();
    wheelCtx.fillStyle = '#ff6b6b';
    wheelCtx.fill();
  };

  const syncParticipantsTextarea = () => {
    const friendsTextarea = getFriendsTextarea();
    if (!friendsTextarea) return;

    friendsTextarea.value = participants.join('\n');
  };

  const updateFriendsList = () => {
    const friendsList = getFriendsList();
    if (!friendsList) return;

    const friendsCount = getFriendsCount();
    const emptyState = getFriendsEmptyState();

    friendsList.innerHTML = '';

    if (friendsCount) {
      friendsCount.textContent = String(getAvailableFriends().length);
    }

    if (emptyState) {
      emptyState.hidden = getAvailableFriends().length > 0;
    }

    for (const friend of getAvailableFriends()) {
      const listItem = document.createElement('li');
      listItem.className =
        'flex items-center justify-between rounded-2xl bg-slate-50 px-3 py-2 text-sm text-slate-700';

      const nameLabel = document.createElement('span');
      nameLabel.textContent = friend;

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className =
        'rounded-full border border-rose-200 px-3 py-1 text-xs font-medium text-rose-600 transition hover:bg-rose-50';
      removeButton.textContent = 'Remove';
      removeButton.setAttribute('aria-label', `Remove ${friend}`);
      removeButton.onclick = () => removeParticipant(friend);

      listItem.appendChild(nameLabel);
      listItem.appendChild(removeButton);
      friendsList.appendChild(listItem);
    }
  };

  const updateGiftHistory = () => {
    const historyList = getGiftHistoryList();
    if (!historyList) return;

    const emptyState = getGiftHistoryEmptyState();
    historyList.innerHTML = '';

    if (emptyState) {
      emptyState.hidden = exchangeState.history.length > 0;
    }

    for (const item of exchangeState.history) {
      const historyItem = document.createElement('li');
      historyItem.className = 'rounded-2xl bg-slate-50 px-3 py-2 text-sm text-slate-700';
      historyItem.textContent = `${item.gifter} -> ${item.receiver}`;
      historyList.appendChild(historyItem);
    }
  };

  const clearWinnerDisplay = () => {
    if (winnerDisplayTimeoutId !== null) {
      window.clearTimeout(winnerDisplayTimeoutId);
      winnerDisplayTimeoutId = null;
    }

    const nameDisplay = getNameDisplay();
    if (!nameDisplay) return;

    nameDisplay.textContent = '';
    nameDisplay.style.backgroundColor = '';
    nameDisplay.classList.remove(NAME_DISPLAY_VISIBLE_CLASS);
    nameDisplay.classList.add(NAME_DISPLAY_HIDDEN_CLASS);
  };

  const updateStatus = () => {
    const statusMessage = getStatusMessage();
    if (!statusMessage) return;

    if (spinning) {
      statusMessage.textContent = 'Spinning...';
      return;
    }

    if (exchangeState.currentGifter !== null) {
      statusMessage.textContent = `Current giver: ${exchangeState.currentGifter}. Spin again to choose a receiver.`;
      return;
    }

    if (exchangeState.history.length > 0 && getAvailableFriends().length === 0) {
      statusMessage.textContent = 'Exchange complete. Reset the draw or edit the list to start over.';
      return;
    }

    if (participants.length < 2) {
      statusMessage.textContent = 'Add at least 2 unique names to begin.';
      return;
    }

    statusMessage.textContent = 'Click the wheel or use the button to choose the first giver.';
  };

  const canSpin = () => {
    if (spinning) return false;
    return exchangeState.currentGifter === null
      ? getAvailableFriends().length >= 2
      : getAvailableFriends().length >= 1;
  };

  const updateControls = () => {
    const spinDisabled = !canSpin();
    const spinButton = getSpinButton();
    if (spinButton) {
      spinButton.disabled = spinDisabled;
    }

    if (wheelCanvas) {
      wheelCanvas.setAttribute('aria-disabled', String(spinDisabled));
      wheelCanvas.classList.toggle('cursor-pointer', !spinDisabled);
      wheelCanvas.classList.toggle('cursor-not-allowed', spinDisabled);
    }
  };

  const resetDraw = () => {
    if (animationId !== null) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }

    spinning = false;
    exchangeState = createExchangeState(participants);
    rotationAngle = 0;
    colors = [];

    clearWinnerDisplay();
    updateFriendsList();
    updateGiftHistory();
    drawWheel();
    updateStatus();
    updateControls();
  };

  const updateParticipantsFromTextarea = () => {
    const friendsTextarea = getFriendsTextarea();
    if (!friendsTextarea) return;

    participants = parseParticipants(friendsTextarea.value);
    resetDraw();
  };

  const removeParticipant = (name: string) => {
    participants = participants.filter((participant) => participant !== name);
    syncParticipantsTextarea();
    resetDraw();
  };

  const spinWheel = () => {
    if (!canSpin()) return;

    spinning = true;

    if (animationId !== null) {
      cancelAnimationFrame(animationId);
    }

    updateStatus();
    updateControls();

    const winnerIndex = Math.floor(Math.random() * getAvailableFriends().length);
    const totalRotations = 5 + Math.floor(Math.random() * 5);
    const targetAngle = getSpinTargetAngle(
      rotationAngle,
      winnerIndex,
      getAvailableFriends().length,
      totalRotations
    );
    const startAngle = rotationAngle;
    const spinDuration = 4000;
    const startTime = performance.now();

    const animateSpin = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / spinDuration, 1);
      const easeOut = 1 - Math.pow(1 - progress, 4);

      rotationAngle = startAngle + (targetAngle - startAngle) * easeOut;
      drawWheel();

      if (progress < 1) {
        animationId = requestAnimationFrame(animateSpin);
      } else {
        rotationAngle = rotationAngle % (2 * Math.PI);
        animationId = null;
        drawWheel();
        showWinner(winnerIndex);
        spinning = false;
        updateStatus();
        updateControls();

        if (confetti) {
          confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 }
          });
        }
      }
    };
    
    animationId = requestAnimationFrame(animateSpin);
  };

  const showWinner = (winnerIndex: number) => {
    const winnerName = getAvailableFriends()[winnerIndex];
    if (!winnerName) return;

    displayWinnerName(winnerName);
    processWinner(winnerIndex);
  };

  const displayWinnerName = (name: string) => {
    const nameDisplay = getNameDisplay();
    if (!nameDisplay) return;

    const pastelColor = getRandomPastelColor();
    nameDisplay.style.backgroundColor = pastelColor;
    nameDisplay.textContent = name;
    nameDisplay.classList.remove(NAME_DISPLAY_HIDDEN_CLASS);
    nameDisplay.classList.add(NAME_DISPLAY_VISIBLE_CLASS);

    winnerDisplayTimeoutId = window.setTimeout(() => {
      clearWinnerDisplay();
    }, 1500);
  };

  const processWinner = (index: number) => {
    const name = getAvailableFriends()[index];
    if (!name) return;

    exchangeState = selectParticipant(exchangeState, index);

    updateFriendsList();
    updateGiftHistory();
    drawWheel();
    updateStatus();
    updateControls();
  };

  const getRandomPastelColor = () => {
    const h = 360 * Math.random();
    const s = 25 + 70 * Math.random() + "%";
    const l = 75 + 10 * Math.random() + "%";
    return `hsl(${h},${s},${l})`;
  };

  const mountWheelCanvas = () => {
    const existingCanvas = document.getElementById('wheelCanvas');
    if (existingCanvas instanceof HTMLCanvasElement) {
      wheelCanvas = existingCanvas;
    } else {
      const wheelContainer = document.getElementById('wheel');
      if (!wheelContainer) return false;

      wheelCanvas = document.createElement('canvas');
      wheelCanvas.id = 'wheelCanvas';
      wheelCanvas.classList.add(
        'mx-auto',
        'block',
        'focus-visible:outline-none',
        'focus-visible:ring-4',
        'focus-visible:ring-slate-300'
      );
      wheelCanvas.setAttribute('role', 'button');
      wheelCanvas.setAttribute('aria-label', 'Spin the gift exchange wheel');
      wheelCanvas.tabIndex = 0;
      const wheelParent = wheelContainer.parentNode;
      if (!wheelParent) return;
      wheelParent.replaceChild(wheelCanvas, wheelContainer);
    }

    const canvas = wheelCanvas;
    if (!canvas.parentElement) return false;

    canvas.onclick = spinWheel;
    canvas.onkeydown = (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;

      event.preventDefault();
      spinWheel();
    };

    const context = canvas.getContext('2d');
    if (!context) return false;

    wheelCtx = context;

    const wheelParent = canvas.parentElement;
    const resizeWheel = () => {
      const nextSize = Math.min(wheelParent.clientWidth, WHEEL_MAX_SIZE);
      if (nextSize < 1 || (canvas.width === nextSize && canvas.height === nextSize)) {
        return;
      }

      canvas.width = nextSize;
      canvas.height = nextSize;
      canvas.style.width = `${nextSize}px`;
      canvas.style.height = `${nextSize}px`;
      drawWheel();
    };

    resizeWheel();
    resizeObserver?.disconnect();
    resizeObserver = new ResizeObserver(resizeWheel);
    resizeObserver.observe(wheelParent);
    return true;
  };

  const initializeApp = () => {
    if (!mountWheelCanvas()) return;

    const spinButton = getSpinButton();
    if (spinButton) {
      spinButton.onclick = spinWheel;
    }

    const resetButton = getResetButton();
    if (resetButton) {
      resetButton.onclick = () => {
        resetDraw();
        syncParticipantsTextarea();
      };
    }

    const friendsTextarea = getFriendsTextarea();
    if (friendsTextarea) {
      friendsTextarea.oninput = updateParticipantsFromTextarea;
    }

    syncParticipantsTextarea();
    resetDraw();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp, { once: true });
  } else {
    initializeApp();
  }
</script>
